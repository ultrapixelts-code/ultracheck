<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8">
  <title>Richiesta <%= order.id %></title>
</head>
<body style="font-family:system-ui; padding:24px;">

  <h1>Richiesta #<%= order.id %></h1>

<p><b>Titolo:</b> <%= order.title %></p>
<p><b>Stato:</b> <%= order.status %></p>

<hr>

<h2>Scheda richiesta</h2>

<h3>Cliente</h3>
<p><b>Cliente finale:</b> <%= order.customer_name || "—" %></p>
<p><b>Email cliente:</b> <%= order.customer_email || "—" %></p>

<h3>Prodotto</h3>
<p><b>Prodotto:</b> <%= order.product_name || "—" %></p>
<p><b>Formato:</b>
  <%= order.width_mm || "—" %> × <%= order.height_mm || "—" %> mm
</p>
<p><b>Quantità richieste:</b> <%= order.quantity_options || "—" %></p>
<p><b>Varianti:</b> <%= order.variants || "—" %></p>

<h3>Materiale e stampa</h3>
<p><b>Materiale:</b> <%= order.material || "—" %></p>
<p><b>Adesivo:</b> <%= order.adhesive || "—" %></p>
<p><b>Colori:</b> <%= order.colors || "—" %></p>
<p><b>Finiture:</b> <%= order.finishing || "—" %></p>

<h3>Dati tecnici bobina</h3>
<p><b>Anima:</b> <%= order.core_mm ? order.core_mm + " mm" : "—" %></p>
<p><b>Uscita:</b> <%= order.unwind_direction ? "Uscita " + order.unwind_direction : "—" %></p>
<p><b>Applicazione:</b> <%= order.application_type || "—" %></p>
<p><b>Dati variabili:</b> <%= order.variable_data ? "Sì" : "No" %></p>
<p><b>Urgente:</b> <%= order.urgent ? "Sì" : "No" %></p>

<h3>Note</h3>
<p><%= order.notes_dealer || "—" %></p>

<% if (quote) { %>
  <hr>
  <h2>Preventivo</h2>
  <% if (quote.price_options) { %>
  <p><b>Prezzi per quantità:</b></p>
  <pre style="background:#f6f7f9; padding:12px; border-radius:10px;"><%= quote.price_options %></pre>
<% } else { %>
  <p><b>Prezzo:</b> <%= (Number(quote.price_total) || 0).toFixed(2) %> €</p>
<% } %>
  <p><b>Lead time:</b> <%= quote.lead_time_days %> giorni</p>
  <% if (quote.sent_at) { %>
    <p style="opacity:.7;">Inviato: <%= new Date(quote.sent_at).toLocaleString('it-IT') %></p>
  <% } %>
<% } %>




  <h2>Azioni</h2>

  <% if (user && user.role === 'admin' && order.status === 'RFQ') { %>
    <h3>Invia preventivo (admin)</h3>
    <form action="/portal/orders/<%= order.id %>/quote" method="POST">
      <label>Prezzi per quantità:</label><br>
<textarea name="price_options" rows="5" style="width:420px;" required placeholder="10.000 pezzi = 450 €
20.000 pezzi = 620 €
30.000 pezzi = 790 €"></textarea>

<br><br>

<label>Prezzo principale (€):</label>
<input type="number" name="price_total" step="0.01" min="0.01" required>
      <label>Lead time (giorni):</label>
      <input type="number" name="lead_time_days" step="1" min="1" required>
      <button type="submit">Invia preventivo</button>
    </form>
  <% } %>

  <% if (user && user.role !== 'admin' && order.status === 'QUOTED') { %>
    <h3>Approva prezzo (dealer)</h3>
    <form action="/portal/orders/<%= order.id %>/confirm" method="POST">
      <button type="submit">Approvo il preventivo</button>
    </form>
  <% } %>

  <% if (user && user.role === 'admin' && (order.status === 'PRICE_APPROVED' || order.status === 'PROOF_CHANGES_REQUESTED')) { %>
    <h3>Invia bozza PDF (admin)</h3>
    <form action="/portal/orders/<%= order.id %>/proof" method="POST" enctype="multipart/form-data">
      <input type="file" name="file" accept="application/pdf" required>
      <button type="submit">Carica bozza e invia</button>
    </form>
  <% } %>

  <% if (user && user.role !== 'admin' && order.status === 'PROOF_SENT') { %>
    <h3>Bozza ricevuta (dealer)</h3>

    <form action="/portal/orders/<%= order.id %>/proof/approve" method="POST" style="margin-bottom:12px;">
      <button type="submit">Approvo la bozza</button>
    </form>

    <form action="/portal/orders/<%= order.id %>/proof/changes" method="POST">
      <label>Note modifiche:</label><br>
      <textarea name="note" rows="3" style="width:340px;" placeholder="Es. cambia colore, sposta logo, ecc"></textarea><br>
      <button type="submit">Richiedo modifiche</button>
    </form>
  <% } %>



<h2>File allegati</h2>

<%
  const proofs = (files || []).filter(f => f.kind === 'PROOF_ADMIN');
  const latestProof = proofs.length ? proofs[0] : null;

  const canSeeProof =
    (user && user.role === 'admin') ||
    ['PROOF_SENT','PROOF_APPROVED','PROOF_CHANGES_REQUESTED'].includes(order.status);

  const visibleFiles = (files || []).filter(f => {
    if (f.kind === 'PROOF_ADMIN') return canSeeProof; // bozza visibile solo quando permesso
    return true;
  });
%>

<% if (latestProof && canSeeProof) { %>
  <p><b>Bozza attuale:</b>
    <a href="/portal/files/<%= latestProof.id %>" target="_blank"><%= latestProof.original_name %></a>
  </p>
<% } %>

<% if (visibleFiles.length > 0) { %>
  <ul>
    <% visibleFiles.forEach(file => { %>
      <li>
        <a href="/portal/files/<%= file.id %>" target="_blank"><%= file.original_name %></a>
        (<%= Math.round((file.size_bytes || 0) / 1024) %> KB)
        <% if (file.kind) { %> — tipo: <%= file.kind %><% } %>
      </li>
    <% }) %>
  </ul>
<% } else { %>
  <p>Nessun file caricato.</p>
<% } %>





  <hr>
<% if (user && user.role === 'admin') { %>
  <h3>Carica logo dealer</h3>
  <form action="/portal/dealers/<%= order.dealer_user_id %>/logo" method="POST" enctype="multipart/form-data">
    <input type="file" name="file" accept="image/png,image/jpeg,image/webp" required />
    <button type="submit">Upload logo</button>
  </form>
<% } %>
<hr>
<h3>Carica nuovo file</h3>
<form action="/portal/orders/<%= order.id %>/files" method="POST" enctype="multipart/form-data">
  <label>Tipo:</label>
  <select name="kind">
    <option value="GENERIC">Generico</option>
    <option value="ARTWORK">Artwork</option>
    <option value="BRIEF">Brief</option>
    <% if (user && user.role === 'admin') { %>
      <option value="PROOF_ADMIN">Bozza admin</option>
    <% } %>
  </select>
  <br><br>
  <input type="file" name="file" required>
  <button type="submit">Carica</button>
</form>
<hr>
  <p><a href="/portal/orders">← Torna alle richieste</a></p>

</body>
</html>

<%
  const title = "Dashboard";
  const body = `
    <div class="shell">
      <header class="topbar">
        <div class="brand">
          <span class="brand__dot" aria-hidden="true"></span>
          <div class="brand__text">
            <div class="brand__name">UltraPixel <span class="brand__sub">Portal</span></div>
            <div class="brand__meta">UltraCheck inside • Premium labels • Fast turnaround</div>
          </div>
        </div>

        <div class="topbar__right">
          <div class="chip">
            <span class="chip__icon" aria-hidden="true">●</span>
            <span class="chip__text">${(user && (user.email || user.name)) ? (user.email || user.name) : "Distributeur"}</span>
          </div>
        </div>
      </header>

      <main class="content">
        <section class="hero">
          <div class="hero__bg" aria-hidden="true"></div>

          <div class="hero__inner">
            <div class="kicker">Gestion distributeurs</div>

            <h1 class="h1">Vos étiquettes : premium.<br/>Rapide. Au prix juste.</h1>
            <p class="lead">Carica file, ricevi preventivi, approva bozze e lancia UltraCheck — in un flusso semplice e tracciato.</p>

            <div class="hero__cta">
              <a class="btn btn--primary" href="/portal/upload">
                <span class="btn__icon" aria-hidden="true">⬆︎</span>
                Carica una nuova richiesta
              </a>
              <a class="btn btn--ghost" href="/portal/orders">
                <span class="btn__icon" aria-hidden="true">↗︎</span>
                Vedi richieste
              </a>
            </div>

            <div class="hero__stats">
              <div class="stat">
                <div class="stat__label">Tempo medio</div>
                <div class="stat__value">Rapido</div>
              </div>
              <div class="stat">
                <div class="stat__label">Qualità</div>
                <div class="stat__value">Premium</div>
              </div>
              <div class="stat">
                <div class="stat__label">Conformità</div>
                <div class="stat__value">UltraCheck</div>
              </div>
            </div>
          </div>
        </section>

        <section class="grid">
          <article class="card card--glow">
            <div class="card__head">
              <div class="pill">Step 1</div>
              <div class="card__title">Upload</div>
            </div>
            <div class="card__text">Carica PDF/immagini + specifiche. Versioni e allegati sempre tracciati.</div>
            <div class="card__footer">
              <span class="hint">PDF • JPG/PNG • Specifiche</span>
            </div>
          </article>

          <article class="card">
            <div class="card__head">
              <div class="pill">Step 2</div>
              <div class="card__title">Preventivo</div>
            </div>
            <div class="card__text">Tu carichi il preventivo PDF. Il distributore conferma con un click.</div>
            <div class="card__footer">
              <span class="hint">Prezzo • Tempi • Note</span>
            </div>
          </article>

          <article class="card">
            <div class="card__head">
              <div class="pill">Step 3</div>
              <div class="card__title">Bozza + UltraCheck</div>
            </div>
            <div class="card__text">Bozza → approvazione → UltraCheck → stampa. Zero confusione, tutto in ordine.</div>
            <div class="card__footer">
              <span class="hint">Approva • Analizza • Produci</span>
            </div>
          </article>
        </section>

        <footer class="footer">
          <span>© ${new Date().getFullYear()} UltraPixel • UltraCheck Portal</span>
        </footer>
      </main>
    </div>
  `;
%>
<%- include("layout", { title, user, body }) %>

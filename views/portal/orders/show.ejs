<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8">
  <title>Richiesta <%= order.id %></title>
</head>
<body style="font-family:system-ui; padding:24px;">

  <h1>Richiesta #<%= order.id %></h1>

  <p><b>Titolo:</b> <%= order.title %></p>
  <p><b>Stato:</b> <%= order.status %></p>


<% if (quote) { %>
  <hr>
  <h2>Preventivo</h2>
  <p><b>Prezzo:</b> <%= Number(quote.price_total).toFixed(2) %> €</p>
  <p><b>Lead time:</b> <%= quote.lead_time_days %> giorni</p>
  <% if (quote.sent_at) { %>
    <p style="opacity:.7;">Inviato: <%= new Date(quote.sent_at).toLocaleString('it-IT') %></p>
  <% } %>
<% } %>


  <h2>Azioni</h2>

  <% if (user && user.role === 'admin' && order.status === 'RFQ') { %>
    <h3>Invia preventivo (admin)</h3>
    <form action="/portal/orders/<%= order.id %>/quote" method="POST">
      <label>Prezzo totale (€):</label>
      <input type="number" name="price_total" step="0.01" min="0.01" required>
      <label>Lead time (giorni):</label>
      <input type="number" name="lead_time_days" step="1" min="1" required>
      <button type="submit">Invia preventivo</button>
    </form>
  <% } %>

  <% if (user && user.role !== 'admin' && order.status === 'QUOTED') { %>
    <h3>Approva prezzo (dealer)</h3>
    <form action="/portal/orders/<%= order.id %>/confirm" method="POST">
      <button type="submit">Approvo il preventivo</button>
    </form>
  <% } %>

  <% if (user && user.role === 'admin' && (order.status === 'PRICE_APPROVED' || order.status === 'PROOF_CHANGES_REQUESTED')) { %>
    <h3>Invia bozza PDF (admin)</h3>
    <form action="/portal/orders/<%= order.id %>/proof" method="POST" enctype="multipart/form-data">
      <input type="file" name="file" accept="application/pdf" required>
      <button type="submit">Carica bozza e invia</button>
    </form>
  <% } %>

  <% if (user && user.role !== 'admin' && order.status === 'PROOF_SENT') { %>
    <h3>Bozza ricevuta (dealer)</h3>

    <form action="/portal/orders/<%= order.id %>/proof/approve" method="POST" style="margin-bottom:12px;">
      <button type="submit">Approvo la bozza</button>
    </form>

    <form action="/portal/orders/<%= order.id %>/proof/changes" method="POST">
      <label>Note modifiche:</label><br>
      <textarea name="note" rows="3" style="width:340px;" placeholder="Es. cambia colore, sposta logo, ecc"></textarea><br>
      <button type="submit">Richiedo modifiche</button>
    </form>
  <% } %>

  <h2>File allegati</h2>

  <%
    const proofs = (files || []).filter(f => f.kind === 'PROOF_ADMIN');
    const latestProof = proofs.length ? proofs[0] : null; // il primo è il più recente (ORDER BY created_at DESC)
  %>

  <% if (latestProof) { %>
    <p><b>Bozza attuale:</b>
      <a href="/portal/files/<%= latestProof.id %>" target="_blank"><%= latestProof.original_name %></a>
    </p>
  <% } %>

  <% if (files && files.length > 0) { %>
    <ul>
      <% files.forEach(file => { %>
        <li>
          <a href="/portal/files/<%= file.id %>" target="_blank">
            <%= file.original_name %>
          </a>
          (<%= Math.round((file.size_bytes || 0) / 1024) %> KB)
          <% if (file.kind) { %>
            — tipo: <%= file.kind %>
          <% } %>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p>Nessun file caricato.</p>
  <% } %>

  <h3>Carica nuovo file</h3>

  <form action="/portal/orders/<%= order.id %>/files"
        method="POST"
        enctype="multipart/form-data">
    <input type="file" name="file" required>
    <button type="submit">Carica</button>
  </form>

  <hr>

  <p><a href="/portal/orders">← Torna alle richieste</a></p>

</body>
</html>

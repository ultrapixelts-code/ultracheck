<%
  const title = "Dashboard";

  const s = stats || {};
  const totalOpen =
    (s.RFQ || 0) +
    (s.QUOTED || 0) +
    (s.PRICE_APPROVED || 0) +
    (s.PROOF_SENT || 0) +
    (s.PROOF_CHANGES_REQUESTED || 0) +
    (s.PROOF_APPROVED || 0) +
    (s.IN_PRODUCTION || 0);

  const body = `
    <div class="shell">
      <header class="topbar">
        <div class="brand">
          <span class="brand__dot" aria-hidden="true"></span>
          <div class="brand__text">
            <div class="brand__name">UltraPixel <span class="brand__sub">Portal</span></div>
            <div class="brand__meta">UltraCheck inside • Premium labels • Fast turnaround</div>
          </div>
        </div>

        <div class="topbar__right">
          <div class="chip">
            <span class="chip__icon" aria-hidden="true">●</span>
            <span class="chip__text">${(user && (user.email || user.name)) ? (user.email || user.name) : "Distributeur"}</span>
          </div>
        </div>
      </header>

      <main class="content">
        <section class="hero">
          <div class="hero__bg" aria-hidden="true"></div>

          <div class="hero__inner">
            <div class="kicker">${user.role === "admin" ? "Dashboard admin" : "Espace distributeur"}</div>

            <h1 class="h1">Gestione richieste etichette</h1>
            <p class="lead">
              Carica file, ricevi preventivi, approva bozze e segui ogni pratica in un flusso semplice e tracciato.
            </p>

            <div class="hero__cta">
              <a class="btn btn--primary" href="/portal/orders/new">
                <span class="btn__icon" aria-hidden="true">＋</span>
                Nuova richiesta
              </a>
              <a class="btn btn--ghost" href="/portal/orders">
                <span class="btn__icon" aria-hidden="true">↗︎</span>
                Tutte le richieste
              </a>
            </div>

            <div class="hero__stats">
              <div class="stat">
                <div class="stat__label">Richieste aperte</div>
                <div class="stat__value">${totalOpen}</div>
              </div>
              <div class="stat">
                <div class="stat__label">Da preventivare</div>
                <div class="stat__value">${s.RFQ || 0}</div>
              </div>
              <div class="stat">
                <div class="stat__label">Bozze in approvazione</div>
                <div class="stat__value">${s.PROOF_SENT || 0}</div>
              </div>
            </div>
          </div>
        </section>

        <section class="grid">
          <article class="card card--glow">
            <div class="card__head">
              <div class="pill">RFQ</div>
              <div class="card__title">Nuove richieste</div>
            </div>
            <div class="card__text">${s.RFQ || 0} richieste in attesa di preventivo.</div>
            <div class="card__footer">
              <span class="hint">Upload • Specifiche • Analisi</span>
            </div>
          </article>

          <article class="card">
            <div class="card__head">
              <div class="pill">Quote</div>
              <div class="card__title">Preventivi inviati</div>
            </div>
            <div class="card__text">${s.QUOTED || 0} preventivi in attesa di approvazione.</div>
            <div class="card__footer">
              <span class="hint">Prezzo • Tempi • Conferma</span>
            </div>
          </article>

          <article class="card">
            <div class="card__head">
              <div class="pill">Proof</div>
              <div class="card__title">Bozze</div>
            </div>
            <div class="card__text">${s.PROOF_SENT || 0} bozze inviate al cliente/distributore.</div>
            <div class="card__footer">
              <span class="hint">Approva • Modifiche • Produzione</span>
            </div>
          </article>
        </section>

        <section class="card" style="margin-top: 22px;">
          <div class="card__head">
            <div class="pill">Ultime</div>
            <div class="card__title">Richieste recenti</div>
          </div>

          ${
            recentOrders && recentOrders.length
              ? `
                <div style="overflow-x:auto;">
                  <table style="width:100%; border-collapse: collapse;">
                    <thead>
                      <tr>
                        <th style="text-align:left; padding:12px 0;">ID</th>
                        <th style="text-align:left; padding:12px 0;">Titolo</th>
                        ${user.role === "admin" ? `<th style="text-align:left; padding:12px 0;">Dealer</th>` : ""}
                        <th style="text-align:left; padding:12px 0;">Stato</th>
                        <th style="text-align:left; padding:12px 0;">Aggiornato</th>
                        <th style="text-align:right; padding:12px 0;"></th>
                      </tr>
                    </thead>
                    <tbody>
                      ${recentOrders.map(o => `
                        <tr style="border-top:1px solid rgba(255,255,255,0.08);">
                          <td style="padding:12px 0;">#${o.id}</td>
                          <td style="padding:12px 0;">${o.title || "Senza titolo"}</td>
                          ${user.role === "admin" ? `<td style="padding:12px 0;">${o.dealer_name || o.email || "—"}</td>` : ""}
                          <td style="padding:12px 0;">${o.status || "—"}</td>
                          <td style="padding:12px 0;">${o.updated_at ? new Date(o.updated_at).toLocaleDateString("it-IT") : "—"}</td>
                          <td style="padding:12px 0; text-align:right;">
                            <a class="btn btn--ghost" style="width:auto; padding:8px 12px;" href="/portal/orders/${o.id}">Apri</a>
                          </td>
                        </tr>
                      `).join("")}
                    </tbody>
                  </table>
                </div>
              `
              : `<div class="card__text">Nessuna richiesta ancora presente.</div>`
          }
        </section>

        <footer class="footer">
          <span>© ${new Date().getFullYear()} UltraPixel • UltraCheck Portal</span>
        </footer>
      </main>
    </div>
  `;
%>
<%- include("layout", { title, user, body }) %>

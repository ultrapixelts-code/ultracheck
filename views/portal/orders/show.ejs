cat > views/portal/orders/show.ejs <<'EOF'
<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8">
  <title>Richiesta <%= order.id %></title>
</head>
<body style="font-family:system-ui; padding:24px;">

  <h1>Richiesta #<%= order.id %></h1>

  <p><b>Titolo:</b> <%= order.title %></p>
  <p><b>Stato:</b> <%= order.status %></p>

  <% if (quote) { %>
    <h3>Preventivo</h3>
    <p>Prezzo: <%= quote.price_total %> €</p>
    <p>Tempi: <%= quote.lead_time_days %> giorni</p>
  <% } else { %>
    <p>Nessun preventivo.</p>
  <% } %>

  <h2>File allegati</h2>

  <% if (files && files.length > 0) { %>
    <ul>
      <% files.forEach(file => { %>
        <li>
          <a href="/portal/files/<%= file.id %>" target="_blank">
            <%= file.original_name %>
          </a>
          (<%= Math.round((file.size_bytes || 0) / 1024) %> KB)
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p>Nessun file caricato.</p>
  <% } %>

  <h3>Carica nuovo file</h3>

  <form action="/portal/orders/<%= order.id %>/files"
        method="POST"
        enctype="multipart/form-data">
    <input type="file" name="file" required>
    <button type="submit">Carica</button>
  </form>

  <hr>

  <p><a href="/portal/orders">← Torna alle richieste</a></p>

</body>
</html>
EOF
